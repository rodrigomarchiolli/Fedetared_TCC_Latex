@article{paul_e__spector_2bae7a3d,
  author = {Paul E. Spector},
  title = {Employee Control and Occupational Stress},
  abstract = {Occupational stress has been recognized as a major health issue for modern work organizations. Conditions of the workplace have been shown to lead to negative emotional reactions (e.g., anxiety), physical health problems in both the short term (e.g., headache or stomach distress) and the long term (cardiovascular disease), and counterproductive behavior at work. Perceptions of control play an important role in this process, being associated with all of these variables. Evidence is growing that enhanced control at work can be an important element in employees' health and well–being. These relationships can be understood in the context of the control–stress model.},
